# Tezrisat development environment template

# Django settings
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
CORS_ALLOW_CREDENTIALS=true

# Leave blank to use the default local SQLite path.
# Docker Compose defaults this to sqlite:////data/db.sqlite3 unless you override it.
DATABASE_URL=

# AI services
OPENAI_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
WOLFRAM_ALPHA_APPID=
SERPAPI_API_KEY=

# Frontend settings
# Keep this browser-reachable for local development.
VITE_API_URL=http://localhost:8000
